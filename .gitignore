# Memoria local AN-KLA: estado volátil y material de atestación —
# no se versiona (ADR-003, 2026-11-04).
.an-kla/

# Logs y pids runtime del motor (exentos del gate de tamaños; nunca publicar).
run/*.log
run/*.pid

# Artefactos de Python y OS.
__pycache__/
.DS_Store

# Evidencia personal del Operador (voz, imagen): local, nunca publicar (repo
# público; D-09 pendiente). El gate de tamaños lo salta (skip_dirs).
docs/reviews/evidence/privado/
# Cualquier grabación del micrófono del Operador (sufijo _tu), esté donde esté.
*_tu.wav

# Descargas y binarios locales de WSL (SPEC-wsl-install); regenerables.
run/build/

# Certificados y claves TLS locales generados en el host
config/certs/

# Almacenamiento local privado de jobs duraderos (Fase I5, Perfil J)
run/jobs/
privado/jobs/
